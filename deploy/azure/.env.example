# Copy to .env on the server (cp .env.example .env) and fill in.
GEMINI_API_KEY=

# Uncomment once data/db/chroma_gemini is in the repo to also run tax_rag.
#COMPOSE_PROFILES=tax

# Public hostnames. Replace 20-1-2-3 with the VM's public IP (dots -> dashes),
# or use your own domain (A records pointing to the VM's IP).
TAX_HOST=tax.20-1-2-3.sslip.io
CREDIT_HOST=credit.20-1-2-3.sslip.io
